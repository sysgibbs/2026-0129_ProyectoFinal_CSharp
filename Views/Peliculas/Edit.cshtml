@model CineMVC.Models.Pelicula

@{
    ViewData["Title"] = "Editar Película";
}

<h1>Editar Película</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label asp-for="Titulo" class="control-label fw-bold"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Sinopsis" class="control-label fw-bold"></label>
                <textarea asp-for="Sinopsis" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Sinopsis" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Genero" class="control-label fw-bold"></label>
                <input asp-for="Genero" class="form-control" />
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Clasificacion" class="control-label fw-bold"></label>
                <input asp-for="Clasificacion" class="form-control" />
                <span asp-validation-for="Clasificacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DuracionMin" class="control-label fw-bold"></label>
                <input asp-for="DuracionMin" class="form-control" type="number" />
                <span asp-validation-for="DuracionMin" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImagenUrl" class="control-label fw-bold"></label>
                <input asp-for="ImagenUrl" class="form-control" />
                <span asp-validation-for="ImagenUrl" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-4">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Activa" /> @Html.DisplayNameFor(model => model.Activa)
                </label>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}