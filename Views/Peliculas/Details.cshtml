@model CineMVC.Models.Pelicula

@{
    ViewData["Title"] = "Detalles de Película";
}

<h1>@Model.Titulo</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Sinopsis</dt>
            <dd class="col-sm-9">@Model.Sinopsis</dd>

            <dt class="col-sm-3">Género</dt>
            <dd class="col-sm-9">@Model.Genero</dd>

            <dt class="col-sm-3">Clasificación</dt>
            <dd class="col-sm-9">@Model.Clasificacion</dd>

            <dt class="col-sm-3">Duración</dt>
            <dd class="col-sm-9">@Model.DuracionMin minutos</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Activa)
                {
                    <span class="badge bg-success">Activa</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactiva</span>
                }
            </dd>
        </dl>
    </div>
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Titulo" class="img-fluid img-thumbnail" />
        }
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>