@model CineMVC.Models.Sala
@{
    ViewData["Title"] = "Eliminar Sala";
}
<h1 class="text-danger">Eliminar Sala</h1>
<h3>¿Estás seguro de que quieres eliminar esta sala?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Capacidad</dt>
        <dd class="col-sm-9">@Model.Capacidad butacas</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Sí, Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>