@model CineMVC.Models.Sala
@{
    ViewData["Title"] = "Detalles de Sala";
}
<h1>Detalles de la Sala</h1>
<hr />
<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>

    <dt class="col-sm-3">Capacidad</dt>
    <dd class="col-sm-9">@Model.Capacidad butacas</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>