@model CineMVC.Models.Sala
@{
    ViewData["Title"] = "Crear Sala";
}
<h1>Crear Sala</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label fw-bold">Nombre de Sala</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Sala 1, VIP, etc." />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Tipo" class="control-label fw-bold">Tipo</label>
                <input asp-for="Tipo" class="form-control" placeholder="Ej: 2D, 3D, IMAX" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Capacidad" class="control-label fw-bold">Capacidad (Asientos)</label>
                <input asp-for="Capacidad" class="form-control" type="number" />
                <span asp-validation-for="Capacidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>